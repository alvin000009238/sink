{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sink",
  "main": ".output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
    "html_handling": "drop-trailing-slash"
  },
  "compatibility_date": "2025-05-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "upload_source_maps": true,
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "sink"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "preview_id": "ef93d42dc4b34969bab404d2e80f8dd3",
      "id": "35f21c9cbfaf4043a0afd77b3b0d03bc"
    }
  ],
  // Optional. Enable only when image uploads or R2 backups are needed.
  // "r2_buckets": [
  //   {
  //     "binding": "R2",
  //     "bucket_name": "sink"
  //   }
  // ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clhs_sink_d1",
      "database_id": "3b0b33ed-43a7-4a18-82c1-17ce4581eff0",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 0 * * *"] // Run backup task daily at 00:00 UTC
  }
}
