{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sink-test",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2025-05-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "test-kv"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "sink-test"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "sink-test"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sink-test",
      "database_id": "test-db",
      "migrations_dir": "migrations"
    }
  ]
}
